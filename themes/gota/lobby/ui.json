      "tint": "cream"
    },
    {
      "id": "search",
      "file": "icons/search.png",
      "use": "Search rooms",
      "tint": "cream"
    },
    {
      "id": "public",
      "file": "icons/globe.png",
      "use": "Public room visibility",
      "tint": "cream"
