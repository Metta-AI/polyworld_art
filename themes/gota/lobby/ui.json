  "primitives": [
    {
      "id": "toggle",
      "drawing": "Rounded track and circular thumb; colors indicate on/off."
    },
    {
      "id": "slotNumber",
      "drawing": "Circle outline with body-size numeral; no separate icon."
    },
    {
      "id": "mapPreview",
      "drawing": "Render the selected map; this is content, not an icon."
    },
    {
      "id": "controls",
      "drawing": "Panel, button, field and badge backgrounds are layout primitives, not icons."
    }
  ],
  "layouts": {
    "battleSetup": {
      "source": "themes/gota/lobby/layouts/battle-setup.html",
      "preview": "themes/gota/lobby/layouts/battle-setup.png",
      "audit": "themes/gota/lobby/layouts/battle-setup-audit.json"
    },
    "multiplayer": {
      "source": "themes/gota/lobby/layouts/multiplayer.html",
      "preview": "themes/gota/lobby/layouts/multiplayer.png",
      "audit": "themes/gota/lobby/layouts/multiplayer-audit.json"
    },
    "stylesheet": "themes/gota/lobby/layouts/ui.css",
    "renderCommand": "python3 themes/gota/lobby/layouts/render.py",
    "note": "Editable static design references, not multiplayer runtime implementation."
  }
}
